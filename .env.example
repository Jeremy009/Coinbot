BITVAVO_API_KEY=xxxxxxxxx
BITVAVO_API_SECRET=xxxxxxxxxxxx

# AWS S3 Storage (required for data persistence)
# Option 1: Use AWS credential chain (AWS CLI, IAM role, etc.) - RECOMMENDED
# Just set the region and bucket name, credentials will be auto-detected
AWS_REGION=eu-central-1  # AWS region where your S3 bucket is located
S3_BUCKET_NAME=coinbot-eu-central-1  # S3 bucket name for storing positions and trades

# Option 2: Use explicit credentials (not recommended for production)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional S3 configuration
# S3_POSITIONS_KEY=positions.json  # S3 key for positions file (optional, default: positions.json)
# S3_TRADES_KEY=trades.log.json  # S3 key for trades log file (optional, default: trades.log.json)
# S3_ENABLE_LOG_UPLOAD=true  # Upload application logs to S3 (optional, default: true)
# S3_LOG_KEY_PREFIX=logs/  # S3 prefix for log files (optional, default: logs/)
# S3_LOG_BUFFER_SIZE=50  # Number of log records to buffer before uploading (optional, default: 50)

# Logging Configuration (optional)
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Bot Configuration (optional)
# BOT_ENABLED=true
# BOT_DRY_RUN=true  # Paper trading mode - HIGHLY RECOMMENDED for testing
# BOT_DRY_RUN_INITIAL_BALANCE=1000.0  # Starting EUR balance for dry-run
# BOT_DRY_RUN_FEE_RATE=0.0030  # Bitvavo taker fee 0.25% + 0.05% slippage (market orders, standard tier)
# BOT_NUM_POSITIONS=5
# BOT_MAX_ALLOCATION_PERCENT=5.0
# BOT_VOLUME_LIMIT=500000
# BOT_TRAILING_STOP_LOSS_PCT=8.0
# BOT_ENTRY_MIN_CONFIDENCE=0.60
# BOT_EXIT_MIN_CONFIDENCE=0.65
# BOT_ANALYSIS_TIME_SPAN=2w  # Historical data: 1h,2h,4h,8h,12h,1d,1w,2w,1m,2m,4m,6m,1y,2y,5y
# BOT_ANALYSIS_TIME_RESOLUTION=1h  # Candle interval: 1m,5m,15m,30m,1h,2h,4h,6h,8h,12h,1d
# BOT_MIN_CANDLES_REQUIRED=200  # Minimum candles for analysis (check: span/resolution >= this)