# Coinbot Environment Variables
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=Coinbot
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Bitvavo API Credentials
# Get your API keys from: https://account.bitvavo.com/user/api
BITVAVO_API_KEY=your_api_key_here
BITVAVO_API_SECRET=your_api_secret_here
BITVAVO_REST_URL=https://api.bitvavo.com/v2
BITVAVO_WS_URL=wss://ws.bitvavo.com/v2/
BITVAVO_ACCESS_WINDOW=10000

# Trading Bot Configuration
BOT_ENABLED=false
BOT_UPDATE_INTERVAL=120
BOT_NUM_POSITIONS=4
BOT_VOLUME_LIMIT=250000.0
BOT_MACD_TIMERESOLUTION=8h
BOT_MACD_SHORT_PERIOD=12
BOT_MACD_LONG_PERIOD=39
BOT_MACD_SIGNAL_PERIOD=9
BOT_TAKER_FEE_PERCENT=0.25
